# ============================================
# NexRun Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Database (PostgreSQL)
# For local development with Docker:
DATABASE_URL="postgresql://nexrun_user:nexrun_password@localhost:5432/nexrun_db?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# UploadThing
UPLOADTHING_TOKEN="your-uploadthing-token-here"

# Application (NEXT_PUBLIC_APP_URL is also required as a Docker build argument)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to true only when a trusted reverse proxy overwrites forwarding headers.
# Production Compose requires this choice to be explicit.
TRUST_PROXY_HEADERS="false"

# Optional PostgreSQL pool tuning
DATABASE_POOL_MAX="10"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_CONNECTION_TIMEOUT_MS="10000"

# Simulated payment provider. Production Compose requires an explicit value;
# keep true until a real payment gateway is integrated and verified.
MOCK_PAYMENT_MODE="true"

# Required only when scheduling the reservation-expiry endpoint
CRON_SECRET="generate-at-least-32-random-characters"

# Resend API key for transactional emails (optional for local dev, required for production)
# Get your key from: https://resend.com/api-keys
# For local dev without email: use dummy value below
RESEND_API_KEY="re_dummy_local_dev_no_emails"
RESEND_FROM_EMAIL="notifications@nexrun.my"
