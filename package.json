{
  "name": "nexrun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "dev": "next dev",
    "dev:fresh": "node scripts/clean-next-dev.mjs && next dev",
    "clean:dev": "node scripts/clean-next-dev.mjs",
    "build": "next build",
    "start": "node --env-file-if-exists=.env scripts/start-standalone.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test tests/e2e/dashboard-responsive.spec.ts",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/prisma-adapter": "^1.6.20",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-email/components": "^0.0.35",
    "@react-email/render": "^1.0.6",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/qrcode": "^1.5.6",
    "@uploadthing/react": "^7.3.3",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "resend": "^6.18.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query-devtools": "^5.64.2",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.11",
    "postcss": "8.5.19",
    "prisma": "^7.9.0",
    "shadcn": "^4.14.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "effect": "3.20.0",
    "postcss": "8.5.19"
  }
}
